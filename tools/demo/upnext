#!/bin/bash
# Demo stand-in for ./upnext: made-up tasks, no Airtable, no token. Used for
# screenshots and UI work. Copy it over an installed plugin's upnext (it's a
# git checkout, so `git checkout upnext` puts the real one back).
# The state comes from $XDG_RUNTIME_DIR/upnext-demo: live | light | limit | setup
mode=$(cat "${XDG_RUNTIME_DIR:-/tmp}/upnext-demo" 2>/dev/null || echo live)
d() { date -d "$1" +%F; }

plan=team; source=setup; calls=212
case $mode in
  light) plan=free; calls=286 ;;
  limit) plan=free; source=billing-error; calls=1000 ;;
esac

case $1 in
  config)
    [ "$mode" = setup ] && { echo '{"ok":false,"error":"no-config","message":"Up Next isn'"'"'t set up yet"}'; exit 0; }
    jq -cn --arg plan $plan --arg src $source --argjson calls $calls '{ok:true,
      tableUrl:"https://airtable.com/appDemo0000000001/tblDemo0000000001",
      open:["Inbox","Next","In Progress"], done:"Done", new:"Next",
      priorities:["Urgent","High","Medium","Low"], projects:true,
      plan:$plan, planSource:$src, calls:$calls, freeMonthly:1000}' ;;
  fetch)
    [ "$mode" = setup ] && { echo '{"ok":false,"error":"no-config","message":"Up Next isn'"'"'t set up yet"}'; exit 0; }
    [ "$mode" = limit ] && { echo '{"ok":false,"error":"monthly-limit","message":"Airtable'"'"'s monthly API limit for this workspace is used up"}'; exit 0; }
    jq -cn --arg plan $plan --argjson calls $calls \
      --arg y "$(d yesterday)" --arg t "$(d today)" --arg t1 "$(d tomorrow)" \
      --arg t2 "$(d '+2 days')" --arg t4 "$(d '+4 days')" --arg t9 "$(d '+9 days')" --arg t20 "$(d '+20 days')" '
      {ok:true, fetchedAt:(now|floor), plan:$plan, calls:$calls, tasks:[
        {id:"recDemo0000000001", name:"Send the October invoice to Northwind", project:"Northwind Rebrand", due:$y, status:"Next", priority:"High"},
        {id:"recDemo0000000002", name:"Review homepage copy", project:"Northwind Rebrand", due:$t, status:"In Progress", priority:"Urgent"},
        {id:"recDemo0000000003", name:"Book the venue for the launch party", project:"Q4 Launch", due:$t, status:"Next", priority:"Medium"},
        {id:"recDemo0000000004", name:"Renew the domain", project:"Admin", due:$t1, status:"Inbox", priority:"Low"},
        {id:"recDemo0000000005", name:"Draft the 2027 roadmap", project:"Planning", due:$t2, status:"Next", priority:"High"},
        {id:"recDemo0000000006", name:"Call the print shop about proofs", project:"Q4 Launch", due:$t4, status:"Inbox", priority:"Medium"},
        {id:"recDemo0000000007", name:"Quarterly backup check", project:"Admin", due:$t9, status:"Next", priority:"Low"},
        {id:"recDemo0000000008", name:"Ship the case study", project:"Portfolio", due:$t20, status:"Next", priority:"Medium"}
      ]}' ;;
  projects)
    echo '{"ok":true,"projects":[{"id":"recDemoP000000001","name":"Admin","client":"","status":"Active"},{"id":"recDemoP000000002","name":"Northwind Rebrand","client":"Northwind","status":"Active"},{"id":"recDemoP000000003","name":"Planning","client":"","status":"Active"},{"id":"recDemoP000000004","name":"Portfolio","client":"","status":"Active"},{"id":"recDemoP000000005","name":"Q4 Launch","client":"Acme","status":"Active"}]}' ;;
  set) jq -cn --arg id "$2" --arg s "$3" '{ok:true,id:$id,status:$s}' ;;
  add) echo '{"ok":true,"id":"recDemoNew0000001"}' ;;
  newproject) jq -cn --arg n "$2" '{ok:true,project:{id:"recDemoP000000009",name:$n,client:"",status:""}}' ;;
  *) echo '{"ok":false,"error":"args","message":"demo"}' ;;
esac
