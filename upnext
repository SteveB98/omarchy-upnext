#!/bin/bash
# Airtable bridge for the Up Next bar widget.
#
#   upnext setup                  guided first run: token, base, table, fields, plan
#   upnext fetch                  open tasks that have a due date
#   upnext set                    change one task's status    stdin: {"id","status"}
#   upnext delete <recId>         delete one task
#   upnext projects               projects that aren't done, with their client
#   upnext add                    create a task               stdin: {"name","due",
#                                   "start","project","status"} (dates YYYY-MM-DD;
#                                   start, project and status optional)
#   upnext newproject             create a project, from today stdin: {"name"}
#   upnext config                 what the widget needs to know about the mapping
#   upnext plan free|team         change the sync profile without running setup
#   upnext usage                  API calls Up Next made this month
#   upnext url [recId]            the table's (or a record's) Airtable URL
#   upnext forget                 remove the token and the config
#
# Every command except setup and forget prints one JSON object:
# {"ok":true,...} or {"ok":false,"error":"<code>","message":"..."}, and exits 0,
# so the widget only ever parses stdout.
#
# Other local accounts can read every process's arguments (/proc/<pid>/cmdline),
# so nothing private is ever passed as one:
#   - The token is an Airtable personal access token in the desktop keyring
#     (libsecret). It reaches curl as a header file on /dev/fd.
#   - What the user typed (task and project names, dates, statuses) arrives
#     here as one JSON line on stdin, goes to curl on stdin or as a /dev/fd
#     file, and reaches jq on stdin or through the environment (env.X), which
#     only this account can read. Never as `jq --arg` or `curl --data`.
# Record, base, table and field ids are opaque and can be arguments.
# tests/run.sh checks this with canary values.

set -o pipefail

# UPNEXT_CONFIG and UPNEXT_STATE exist for the offline tests (tests/run.sh).
CONFIG=${UPNEXT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/upnext/config.json}
STATE=${UPNEXT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/upnext}
API=https://api.airtable.com/v0
KEYRING=(service airtable account io.github.steveb98.upnext)
FREE_MONTHLY=1000

ID_RE='^[A-Za-z0-9]{17}$'
DATE_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'

# Messages can quote Airtable, which can echo a value, so they go through env.
fail() { E=$1 M=$2 jq -cn '{ok:false,error:env.E,message:env.M}'; exit 0; }

# Commands that carry what the user typed read it as one JSON object on stdin.
read_input() {
  INPUT=""
  IFS= read -r -t 10 INPUT || [ -n "$INPUT" ] || fail args "Expected the details as one line of JSON on stdin"
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$INPUT" || fail args "The details on stdin aren't a JSON object"
}
# input <key> -> that value of the stdin object, or empty
input() { jq -r --arg k "$1" '.[$k] // empty | tostring' <<<"$INPUT"; }

# ------------------------------------------------------------------ config

# cfg '<jq filter>' reads from the config; -r output.
cfg() { jq -r "$1 // empty" "$CONFIG"; }

load_config() {
  [ -r "$CONFIG" ] || fail no-config "Up Next isn't set up yet"
  jq -e '.version == 1 and (.baseId|test("^app")) and (.tableId|test("^tbl"))' "$CONFIG" >/dev/null 2>&1 \
    || fail no-config "Up Next's config is damaged; run setup again"
  BASE=$(cfg .baseId)
  TABLE=$(cfg .tableId)
  [[ $BASE =~ $ID_RE && $TABLE =~ $ID_RE ]] || fail no-config "Up Next's config has a bad base or table id"
}

# Rewrite the config through jq without loosening its permissions.
update_config() {
  local tmp
  tmp=$(mktemp "${CONFIG}.XXXXXX") || return 1
  if jq "$@" "$CONFIG" > "$tmp"; then mv "$tmp" "$CONFIG"; else rm -f "$tmp"; return 1; fi
}

# ------------------------------------------------------------------ usage

month() { date +%Y-%m; }

# Count one API call against this base for the current month.
count_call() {
  [ -n "$BASE" ] || return 0
  { mkdir -p "$STATE" && chmod 700 "$STATE"; } 2>/dev/null || return 0
  local f="$STATE/usage.json"
  (
    flock -w 2 9 || exit 0
    local cur='{}'
    [ -s "$f" ] && cur=$(cat "$f")
    jq -c --arg m "$(month)" --arg b "$BASE" '
      (if .month == $m then . else {month:$m, calls:{}} end)
      | .calls[$b] = ((.calls[$b] // 0) + 1)' <<<"$cur" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  ) 9>"$STATE/usage.lock"
}

calls_this_month() {
  local f="$STATE/usage.json"
  [ -s "$f" ] || { echo 0; return; }
  jq -r --arg m "$(month)" --arg b "${BASE:-}" 'if .month == $m then (.calls[$b] // 0) else 0 end' "$f" 2>/dev/null || echo 0
}

# ------------------------------------------------------------------ http

token() {
  TOKEN=$(secret-tool lookup "${KEYRING[@]}" 2>/dev/null)
  [ -n "$TOKEN" ] || fail no-token "No Airtable token in the keyring"
}

# Free plan's monthly cap: switch this install to the light profile.
hit_monthly_limit() {
  [ -w "$CONFIG" ] && update_config '.plan = "free" | .planSource = "billing-error"' 2>/dev/null
  fail monthly-limit "Airtable's monthly API limit for this workspace is used up"
}

curl_api() {
  curl -sS --max-time 20 -w '\n%{http_code}' -H @<(printf 'Authorization: Bearer %s\n' "$TOKEN") "$@"
}

# curl wrapper: sets $BODY and $CODE, maps errors to {ok:false} and exits.
# Only calls that reach Airtable count against the month.
# Private values stay off curl's command line:
#   PRIVATE_BODY=<json> call ... --data-binary @-   the body goes in on stdin
#   PRIVATE_FORMULA=<formula> call -G ...           filterByFormula, as a /dev/fd file
call() {
  local out
  if [ -n "${PRIVATE_FORMULA:-}" ]; then
    out=$(curl_api "$@" --data-urlencode "filterByFormula@"<(printf '%s' "$PRIVATE_FORMULA") 2>&1 <<<"${PRIVATE_BODY-}") \
      || fail network "Can't reach Airtable"
  else
    out=$(curl_api "$@" 2>&1 <<<"${PRIVATE_BODY-}") || fail network "Can't reach Airtable"
  fi
  count_call
  CODE=${out##*$'\n'}
  BODY=${out%$'\n'*}
  local type
  type=$(jq -r '.error.type // .error // empty' <<<"$BODY" 2>/dev/null)
  # Callers can take some failures themselves: ALLOW_STATUS="403 422".
  [[ " ${ALLOW_STATUS:-} " == *" $CODE "* ]] && return 0
  case $CODE in
    2??) ;;
    401) fail auth "Airtable rejected the token" ;;
    403) fail access "The token can't use this base (check its scopes and access)" ;;
    404) fail access "Airtable can't find the base or table (was it deleted, or is it outside the token's access?)" ;;
    422) fail http "Airtable said: $(jq -r '.error.message // .error.type // .error // empty' <<<"$BODY" 2>/dev/null)" ;;
    429) [[ $type == *BILLING* ]] && hit_monthly_limit
         fail rate "Airtable is busy (rate limit). Try again in a minute." ;;
    *) fail http "Airtable error $CODE: $(jq -r '.error.message // .error.type // .error // empty' <<<"$BODY" 2>/dev/null)" ;;
  esac
}

# <list so far> -> the list plus this page's records. Both go through stdin:
# a long list is too big for one jq argument (Linux caps those at 128 KiB).
add_page() { printf '%s\n%s' "$1" "$BODY" | jq -cs '.[0] + .[1].records'; }

# A write to one record got a 403 or 404. Airtable answers that way both
# when the record is gone and when the base or table is out of reach, so one
# read of the table tells them apart: if it fails, call() reports why.
check_table() {
  call -G "$API/$BASE/$TABLE" --data-urlencode "maxRecords=1" \
    --data-urlencode "fields[]=$(cfg .fields.name.id)"
}

# ------------------------------------------------------------------ formulas

# Formulas take field names, not ids. Escape them for {Field} and 'string'.
formula() {
  jq -r '
    def ref: "{" + (gsub("\\\\"; "\\\\") | gsub("}"; "\\}")) + "}";
    def str: $q + (gsub("\\\\"; "\\\\") | gsub($q; "\\" + $q)) + $q;
    .fields as $f
    | "AND(OR(" + ([.statuses.open[] | ($f.status.name|ref) + "=" + str] | join(",")) + "),"
      + ($f.due.name|ref) + ")"' --arg q "'" "$CONFIG"
}

project_formula() {
  jq -r '
    def ref: "{" + (gsub("\\\\"; "\\\\") | gsub("}"; "\\}")) + "}";
    def str: $q + (gsub("\\\\"; "\\\\") | gsub($q; "\\" + $q)) + $q;
    .projects as $p
    | if ($p.status == null or ($p.doneStatuses|length) == 0) then ""
      else "NOT(OR(" + ([$p.doneStatuses[] | ($p.status.name|ref) + "=" + str] | join(",")) + "))" end' --arg q "'" "$CONFIG"
}

# A field was renamed in Airtable: pick up the new names by id, once.
refresh_names() {
  ALLOW_STATUS=403 call "$API/meta/bases/$BASE/tables"
  [ "$CODE" = 403 ] && return 1   # token without schema.bases:read
  # A big base's schema is too long for one argument, so it goes in on stdin.
  update_config --slurpfile s /dev/stdin '
    ($s[0].tables | map({key:.id, value:(.fields | map({key:.id, value:.name}) | from_entries)}) | from_entries) as $n
    | .tableId as $t
    | .fields |= with_entries(if .value == null then . else .value.name = ($n[$t][.value.id] // .value.name) end)
    | if .projects == null then . else
        .projects.tableId as $pt
        | .projects |= with_entries(if (.value|type) == "object" and (.value.id? // null) != null
                                     then .value.name = ($n[$pt][.value.id] // .value.name) else . end)
      end' <<<"$BODY"
}

# ------------------------------------------------------------------ commands

fetch() {
  load_config
  token
  local f_name f_due f_status f_prio f_proj f_label
  f_name=$(cfg .fields.name.id); f_due=$(cfg .fields.due.id); f_status=$(cfg .fields.status.id)
  f_prio=$(cfg .fields.priority.id); f_proj=$(cfg .fields.project.id); f_label=$(cfg .fields.projectLabel.id)

  local attempt
  for attempt in 1 2; do
    local offset="" pages="[]" retry=""
    while :; do
      local args=(-G "$API/$BASE/$TABLE"
        --data-urlencode "returnFieldsByFieldId=true"
        --data-urlencode "pageSize=100"
        --data-urlencode "cellFormat=json")
      local fld
      for fld in "$f_name" "$f_due" "$f_status" "$f_prio" "$f_proj" "$f_label"; do
        [ -n "$fld" ] && args+=(--data-urlencode "fields[]=$fld")
      done
      [ -n "$offset" ] && args+=(--data-urlencode "offset=$offset")
      PRIVATE_FORMULA=$(formula) ALLOW_STATUS=422 call "${args[@]}"
      if [ "$CODE" = 422 ]; then retry=1; break; fi
      pages=$(add_page "$pages")
      offset=$(jq -r '.offset // empty' <<<"$BODY")
      [ -n "$offset" ] || break
    done
    if [ -z "$retry" ]; then break; fi
    [ "$attempt" = 2 ] && fail config "A mapped field or status no longer matches the base; run setup again"
    refresh_names || fail config "A mapped field changed; run setup again"
  done

  # Linked projects show by name: from a lookup field if the table has one,
  # otherwise from the cached project list.
  local names='{}'
  if [ -n "$f_proj" ] && [ -z "$f_label" ]; then
    names=$(project_names "$pages")
    # project_names runs in a subshell, so a failed call comes back as its
    # error line. A passing hiccup keeps the cached names; the rest is reported.
    if jq -e 'has("ok")' <<<"$names" >/dev/null 2>&1; then
      case $(jq -r '.error' <<<"$names") in
        network|rate) names=$(jq -c '.names // {}' "$STATE/projects-$BASE.json" 2>/dev/null || echo '{}') ;;
        *) echo "$names"; exit 0 ;;
      esac
    fi
  fi

  printf '%s\n%s' "$pages" "$names" | jq -cs --arg n "$f_name" --arg d "$f_due" --arg s "$f_status" --arg r "$f_prio" \
    --arg p "$f_proj" --arg l "$f_label" \
    --arg plan "$(cfg .plan)" --argjson calls "$(calls_this_month)" '
    .[1] as $names | .[0]
    | {ok:true, fetchedAt:(now|floor), plan:$plan, calls:$calls, tasks:[ .[] | {
      id,
      name: (.fields[$n] // "Untitled" | tostring),
      project: (if $l != "" then ((.fields[$l] // []) | map(tostring) | join(", "))
                elif $p != "" then ((.fields[$p] // []) | map($names[.] // empty) | join(", "))
                else "" end),
      # Date fields are YYYY-MM-DD; dateTime fields are UTC, so convert to local.
      due: (.fields[$d] // "" | tostring
            | if length > 10 then (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | localtime | strftime("%Y-%m-%d"))
              else . end),
      status: (.fields[$s] // "" | if type == "object" then .name else tostring end),
      priority: (if $r == "" then "" else (.fields[$r] // "" | if type == "object" then .name else tostring end) end)
    } | select(.due | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) ]}'
}

# id -> project name for every project the tasks link to. The names are
# cached; the list is fetched again only when an unknown id shows up and the
# cache is older than PROJECT_TTL seconds (light profile: an hour).
project_names() {
  local pages=$1 cache="$STATE/projects-$BASE.json"
  local ttl=60
  [ "$(cfg .plan)" = free ] && ttl=3600
  local want
  want=$(jq -c --arg p "$(cfg .fields.project.id)" '[.[] | .fields[$p][]?] | unique' <<<"$pages")
  local have='{}' age=999999
  if [ -s "$cache" ]; then
    have=$(jq -c '.names // {}' "$cache" 2>/dev/null || echo '{}')
    age=$(( $(date +%s) - $(jq -r '.at // 0' "$cache" 2>/dev/null || echo 0) ))
  fi
  local missing
  missing=$(printf '%s\n%s' "$want" "$have" | jq -s '.[1] as $h | [.[0][] | select($h[.] == null)] | length')
  if [ "$missing" -gt 0 ] && [ "$age" -ge "$ttl" ]; then
    local tbl pn offset="" all="[]"
    tbl=$(cfg .projects.tableId); pn=$(cfg .projects.name.id)
    if [[ $tbl =~ $ID_RE ]] && [ -n "$pn" ]; then
      while :; do
        local args=(-G "$API/$BASE/$tbl" --data-urlencode "returnFieldsByFieldId=true"
          --data-urlencode "pageSize=100" --data-urlencode "fields[]=$pn")
        [ -n "$offset" ] && args+=(--data-urlencode "offset=$offset")
        call "${args[@]}"
        all=$(add_page "$all")
        offset=$(jq -r '.offset // empty' <<<"$BODY")
        [ -n "$offset" ] || break
      done
      have=$(jq -c --arg pn "$pn" 'map({key:.id, value:(.fields[$pn] // "" | tostring)}) | from_entries' <<<"$all")
      mkdir -p "$STATE" && chmod 700 "$STATE"
      jq -c '{at:(now|floor), names:.}' <<<"$have" > "$cache"
    fi
  fi
  echo "$have"
}

set_status() {
  read_input
  local id status
  id=$(input id); status=$(input status)
  [[ $id =~ ^rec[A-Za-z0-9]{14}$ ]] || fail args "Bad record id"
  load_config
  STATUS=$status jq -e '(.statuses.open + [.statuses.done]) | index(env.STATUS)' "$CONFIG" >/dev/null \
    || fail args "That status isn't one Up Next manages"
  token
  local body
  body=$(STATUS=$status FIELD=$(cfg .fields.status.id) jq -cn '{fields:{(env.FIELD): env.STATUS}}')
  ALLOW_STATUS="403 404" PRIVATE_BODY=$body call -X PATCH "$API/$BASE/$TABLE/$id" \
    -H "Content-Type: application/json" --data-binary @-
  if [ "$CODE" = 403 ] || [ "$CODE" = 404 ]; then
    check_table
    fail gone "That task is no longer in Airtable"
  fi
  jq -c '{ok:true, id, status}' <<<"$INPUT"
}

# A task that is already gone counts as deleted.
delete_task() {
  [[ $1 =~ ^rec[A-Za-z0-9]{14}$ ]] || fail args "Bad record id"
  load_config
  token
  ALLOW_STATUS="403 404" call -X DELETE "$API/$BASE/$TABLE/$1"
  if [ "$CODE" = 403 ] || [ "$CODE" = 404 ]; then
    check_table
    jq -cn --arg id "$1" '{ok:true,id:$id,deleted:true,gone:true}'
    return
  fi
  jq -cn --arg id "$1" '{ok:true,id:$id,deleted:true}'
}

projects() {
  load_config
  local tbl pn pc ps
  tbl=$(cfg .projects.tableId)
  [[ $tbl =~ $ID_RE ]] || fail no-projects "No projects table is mapped"
  pn=$(cfg .projects.name.id); pc=$(cfg .projects.client.id); ps=$(cfg .projects.status.id)
  token
  # cellFormat=string turns a linked client into its name.
  local filter offset="" pages="[]"
  filter=$(project_formula)
  while :; do
    local args=(-G "$API/$BASE/$tbl"
      --data-urlencode "returnFieldsByFieldId=true"
      --data-urlencode "cellFormat=string"
      --data-urlencode "timeZone=$(time_zone)"
      --data-urlencode "userLocale=$(user_locale)"
      --data-urlencode "fields[]=$pn")
    [ -n "$pc" ] && args+=(--data-urlencode "fields[]=$pc")
    [ -n "$ps" ] && args+=(--data-urlencode "fields[]=$ps")
    [ -n "$offset" ] && args+=(--data-urlencode "offset=$offset")
    PRIVATE_FORMULA=$filter call "${args[@]}"
    pages=$(add_page "$pages")
    offset=$(jq -r '.offset // empty' <<<"$BODY")
    [ -n "$offset" ] || break
  done
  jq -c --arg n "$pn" --arg c "$pc" --arg s "$ps" '
    {ok:true, projects:([ .[] | select((.fields[$n] // "") != "") | {
      id, name: .fields[$n],
      client: (if $c == "" then "" else (.fields[$c] // "") end),
      status: (if $s == "" then "" else (.fields[$s] // "") end)
    } ] | sort_by(.name | ascii_downcase))}' <<<"$pages"
}

add_task() {
  read_input
  local name project start due status
  name=$(input name); project=$(input project); start=$(input start); due=$(input due); status=$(input status)
  [ -n "${name// /}" ] || fail args "Task needs a name"
  [[ $due =~ $DATE_RE ]] || fail args "Due date must be YYYY-MM-DD"
  [ "$start" = "-" ] || [ -z "$start" ] || [[ $start =~ $DATE_RE ]] || fail args "Start date must be YYYY-MM-DD"
  [ "$project" = "-" ] || [ -z "$project" ] || [[ $project =~ ^rec[A-Za-z0-9]{14}$ ]] || fail args "Bad project id"
  load_config
  [ -n "$status" ] || status=$(cfg .statuses.new)
  STATUS=$status jq -e '(.statuses.open + [.statuses.done]) | index(env.STATUS)' "$CONFIG" >/dev/null \
    || fail args "That status isn't one Up Next manages"
  token
  local body
  body=$(STATUS=$status jq -c --slurpfile c "$CONFIG" '
    . as $in | $c[0].fields as $f
    | ($in.start // "" | if . == "-" then "" else . end) as $start
    | ($in.project // "" | if . == "-" then "" else . end) as $project
    | {fields:(
        {($f.name.id): $in.name, ($f.due.id): $in.due, ($f.status.id): env.STATUS}
        + (if $start == "" or $f.start == null then {} else {($f.start.id): $start} end)
        + (if $project == "" or $f.project == null then {} else {($f.project.id): [$project]} end)
      )}' <<<"$INPUT")
  PRIVATE_BODY=$body call -X POST "$API/$BASE/$TABLE" -H "Content-Type: application/json" --data-binary @-
  jq -c '{ok:true, id}' <<<"$BODY"
}

new_project() {
  read_input
  local name
  name=$(input name)
  [ -n "${name// /}" ] || fail args "Project needs a name"
  load_config
  local tbl
  tbl=$(cfg .projects.tableId)
  [[ $tbl =~ $ID_RE ]] || fail no-projects "No projects table is mapped"
  token
  local body
  body=$(jq -c --slurpfile c "$CONFIG" --arg today "$(date +%F)" '
    . as $in | $c[0].projects as $p
    | {fields:(
        {($p.name.id): $in.name}
        + (if $p.status == null or ($p.newStatus // "") == "" then {} else {($p.status.id): $p.newStatus} end)
        + (if $p.start == null then {} else {($p.start.id): $today} end)
      )}' <<<"$INPUT")
  PRIVATE_BODY=$body call -X POST "$API/$BASE/$tbl" -H "Content-Type: application/json" --data-binary @-
  rm -f "$STATE/projects-$BASE.json"
  printf '%s\n%s' "$INPUT" "$BODY" | jq -cs '{ok:true, project:{id:.[1].id, name:.[0].name, client:"", status:""}}'
}

show_config() {
  load_config
  jq -c --argjson calls "$(calls_this_month)" --argjson cap $FREE_MONTHLY '{
    ok: true,
    tableUrl: ("https://airtable.com/" + .baseId + "/" + .tableId),
    open: .statuses.open, done: .statuses.done, new: .statuses.new,
    priorities: (.priorities // []),
    projects: (.projects != null),
    plan: (.plan // "free"), planSource: (.planSource // "setup"),
    calls: $calls, freeMonthly: $cap
  }' "$CONFIG"
}

set_plan() {
  [[ $1 == free || $1 == team ]] || fail args "Plan must be free or team"
  load_config
  update_config --arg p "$1" '.plan = $p | .planSource = "user"' || fail config "Couldn't save the plan"
  jq -cn --arg p "$1" '{ok:true, plan:$p}'
}

usage() {
  load_config
  jq -cn --arg m "$(month)" --argjson c "$(calls_this_month)" --arg plan "$(cfg .plan)" --argjson cap $FREE_MONTHLY \
    '{ok:true, month:$m, calls:$c, plan:$plan, freeMonthly:$cap}'
}

record_url() {
  load_config
  if [ -z "$1" ]; then echo "https://airtable.com/$BASE/$TABLE"; return; fi
  [[ $1 =~ ^rec[A-Za-z0-9]{14}$ ]] || fail args "Bad record id"
  echo "https://airtable.com/$BASE/$TABLE/$1"
}

time_zone() {
  local tz
  tz=$(timedatectl show -p Timezone --value 2>/dev/null)
  [ -n "$tz" ] || tz=${TZ#:}
  [[ $tz =~ ^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$ ]] || tz=UTC
  echo "$tz"
}

user_locale() {
  local l=${LC_ALL:-${LC_TIME:-${LANG:-en_US}}}
  l=${l%%.*}; l=${l//_/-}
  [[ $l =~ ^[a-zA-Z]{2,3}(-[a-zA-Z]{2})?$ ]] || l=en-us
  echo "${l,,}"
}

# ------------------------------------------------------------------ setup

# Only fixed text goes to say: gum gets it as an argument.
say() { if command -v gum >/dev/null; then gum style --foreground 2 "$*"; else printf '\n%s\n' "$*"; fi; }

# The menus list base, table, field and status names, so gum reads them from
# stdin and the preselected ones from its environment, not its arguments.

# choose "prompt" default-index item... -> prints the chosen item
choose() {
  local prompt=$1 def=$2; shift 2
  if command -v gum >/dev/null && [ -t 0 ]; then
    printf '%s\n' "$@" | GUM_CHOOSE_SELECTED=${*:def+1:1} gum choose --header "$prompt"
    return
  fi
  echo "$prompt" >&2
  local i=1 item
  for item in "$@"; do printf '  %d) %s\n' "$i" "$item" >&2; i=$((i + 1)); done
  local pick
  while :; do
    read -r -p "Number [$((def + 1))]: " pick || return 1
    pick=${pick:-$((def + 1))}
    if [[ $pick =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le $# ]; then
      printf '%s\n' "${@:pick:1}"
      return
    fi
  done
}

# choose_many "prompt" "default items, newline separated" item... -> chosen items, one per line
choose_many() {
  local prompt=$1 defs=$2; shift 2
  # gum takes the preselected list comma-separated, so a name with a comma
  # uses the numbered menu instead.
  if command -v gum >/dev/null && [ -t 0 ] && [[ $defs != *,* ]]; then
    local sel
    sel=$(paste -sd, <<<"${defs%$'\n'}")
    printf '%s\n' "$@" | GUM_CHOOSE_SELECTED=$sel gum choose --no-limit --header "$prompt (space to toggle, enter to accept)"
    return
  fi
  echo "$prompt" >&2
  local i=1 item marks=()
  for item in "$@"; do
    [[ $'\n'$defs == *$'\n'"$item"$'\n'* ]] && marks+=("$i")
    printf '  %d) %s\n' "$i" "$item" >&2
    i=$((i + 1))
  done
  local pick
  read -r -p "Numbers, space separated [${marks[*]}]: " pick || return 1
  pick=${pick:-${marks[*]}}
  local n
  for n in $pick; do
    [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le $# ] && printf '%s\n' "${@:n:1}"
  done
}

# Index of the first item matching a regex (case-insensitive), else $3.
first_match() {
  local re=$1 fallback=$2; shift 2
  local i=0 item
  for item in "$@"; do
    if [[ ${item,,} =~ $re ]]; then echo "$i"; return; fi
    i=$((i + 1))
  done
  echo "$fallback"
}

# pick_field <label> <regex> <optional:0|1> <jq type filter> [table json] [field id]
#   -> {"id","name"} or null. The filter can use $other, the optional field id
#   (for example the field already picked for something else).
pick_field() {
  local label=$1 re=$2 optional=$3 types=$4 tbl=${5:-$TABLE_JSON} other=${6:-}
  local names ids
  mapfile -t names < <(jq -r --arg other "$other" ".fields[] | select($types) | .name" <<<"$tbl")
  mapfile -t ids < <(jq -r --arg other "$other" ".fields[] | select($types) | .id" <<<"$tbl")
  if [ ${#names[@]} -eq 0 ]; then
    [ "$optional" = 1 ] && { echo null; return; }
    echo "This table has no field that can be the $label." >&2
    return 1
  fi
  local opts=("${names[@]}") def
  def=$(first_match "$re" -1 "${names[@]}")
  if [ "$optional" = 1 ]; then
    opts+=("(none)")
    [ "$def" = -1 ] && def=${#names[@]}
  else
    [ "$def" = -1 ] && def=0
  fi
  local pick
  pick=$(choose "$label:" "$def" "${opts[@]}") || return 1
  [ "$pick" = "(none)" ] && { echo null; return; }
  local i
  for i in "${!names[@]}"; do
    if [ "${names[$i]}" = "$pick" ]; then
      ID=${ids[$i]} NAME=$pick jq -cn '{id:env.ID, name:env.NAME}'
      return
    fi
  done
  return 1
}

choices_of() { # <table json> <field id>
  jq -r --arg f "$2" '.fields[] | select(.id == $f) | .options.choices[]?.name' <<<"$1"
}

setup() {
  # In the terminal, errors are a readable line, and the window stays open.
  fail() { echo; echo "Airtable: $2" >&2; read -r -p "Press Enter to close. " _; exit 1; }

  echo
  say "Up Next setup (about 2 minutes)"
  cat <<'EOF'

Up Next shows tasks from an Airtable table in your bar. It needs:
  - an Airtable personal access token (it stays in your desktop keyring), and
  - a table with a name, a status (single select) and a due date.

No table yet? Copy the template base first: see the README's Quick start.
EOF

  # ---- token
  local existing keep=n
  existing=$(secret-tool lookup "${KEYRING[@]}" 2>/dev/null)
  if [ -n "$existing" ]; then
    read -r -p "A token is already saved. Keep it? [Y/n] " keep || return 1
    [[ ${keep:-y} =~ ^[Yy] ]] && keep=y
  fi
  if [ "$keep" != y ]; then
    echo
    say "1. Create a token"
    cat <<'EOF'
Your browser will open Airtable's token page. Create a token with:
  Scopes:  data.records:read   data.records:write   schema.bases:read
  Access:  the base that holds your tasks (nothing else is needed)
EOF
    read -r -p "Press Enter to open the token page... " || return 1
    xdg-open "https://airtable.com/create/tokens/new" >/dev/null 2>&1 &
    local tok
    while :; do
      read -r -s -p "Paste the token (input is hidden): " tok || { echo; return 1; }
      echo
      tok=$(tr -d ' \t\r\n' <<<"$tok")
      [[ $tok =~ ^pat[A-Za-z0-9]+\.[A-Za-z0-9]+$ ]] && break
      echo "That doesn't look like an Airtable token (it starts with \"pat\"). Try again."
    done
    printf '%s' "$tok" | secret-tool store --label="Airtable (Up Next)" "${KEYRING[@]}" \
      || { echo "Couldn't save the token in the keyring."; return 1; }
    unset tok
    echo "Token saved in the keyring."
  fi
  token

  # whoami checks the token itself (a bad one is a 401). It doesn't list a
  # personal token's scopes, so the schema scope shows up as a 403 below.
  call "$API/meta/whoami"

  # ---- base
  echo
  say "2. Pick the base"
  local bases
  ALLOW_STATUS=403 call "$API/meta/bases"
  if [ "$CODE" = 403 ]; then
    echo "This token can't read your bases' structure. Add the schema.bases:read scope"
    echo "to it on https://airtable.com/create/tokens (the token itself stays the same),"
    echo "then run setup again."
    return 1
  fi
  bases=$BODY
  local bnames bids
  mapfile -t bnames < <(jq -r '.bases[].name' <<<"$bases")
  mapfile -t bids < <(jq -r '.bases[].id' <<<"$bases")
  [ ${#bids[@]} -gt 0 ] || { echo "The token can't see any bases. Give it access to your tasks base."; return 1; }
  local bpick def i
  def=$(first_match 'task|up next|todo' 0 "${bnames[@]}")
  bpick=$(choose "Base:" "$def" "${bnames[@]}") || return 1
  for i in "${!bnames[@]}"; do [ "${bnames[$i]}" = "$bpick" ] && BASE=${bids[$i]}; done
  [[ $BASE =~ $ID_RE ]] || return 1

  # ---- table
  local schema tnames tids tpick
  call "$API/meta/bases/$BASE/tables"
  schema=$BODY
  mapfile -t tnames < <(jq -r '.tables[].name' <<<"$schema")
  mapfile -t tids < <(jq -r '.tables[].id' <<<"$schema")
  def=$(first_match 'task|todo|to-do' 0 "${tnames[@]}")
  tpick=$(choose "Table with your tasks:" "$def" "${tnames[@]}") || return 1
  for i in "${!tnames[@]}"; do [ "${tnames[$i]}" = "$tpick" ] && TABLE=${tids[$i]}; done
  TABLE_JSON=$(jq -c --arg t "$TABLE" '.tables[] | select(.id == $t)' <<<"$schema")

  # ---- fields
  echo
  say "3. Match the fields"
  echo "The best guesses are preselected. Press Enter to accept each one."
  local f_name f_due f_status f_prio f_start f_proj
  local primary
  primary=$(jq -r '.primaryFieldId' <<<"$TABLE_JSON")
  f_name=$(pick_field "Task name" "^(name|task|title)" 0 '.id == $other or .type == "singleLineText" or .type == "formula"' "" "$primary") || return 1
  f_due=$(pick_field "Due date" 'due|end|deadline' 0 '.type == "date" or .type == "dateTime"') || return 1
  f_status=$(pick_field "Status (single select)" 'status|state|stage' 0 '.type == "singleSelect"') || return 1
  f_prio=$(pick_field "Priority (optional)" 'priority|importance' 1 '.type == "singleSelect" and .id != $other' "" "$(jq -r .id <<<"$f_status")") || return 1
  f_start=$(pick_field "Start date (optional)" 'start|begin' 1 '(.type == "date" or .type == "dateTime") and .id != $other' "" "$(jq -r .id <<<"$f_due")") || return 1
  f_proj=$(pick_field "Project link (optional)" 'project|client|job' 1 '.type == "multipleRecordLinks"') || return 1

  # ---- statuses
  local statuses open done_status new
  mapfile -t statuses < <(choices_of "$TABLE_JSON" "$(jq -r .id <<<"$f_status")")
  [ ${#statuses[@]} -gt 1 ] || { echo "The status field needs at least two options (for example Next and Done)."; return 1; }
  local closed_re='done|complete|finish|cancel|archiv|closed|drop|won.?t'
  local s defs=""
  for s in "${statuses[@]}"; do [[ ${s,,} =~ $closed_re ]] || defs+="$s"$'\n'; done
  open=$(choose_many "Which statuses count as open (shown in the list)?" "$defs" "${statuses[@]}") || return 1
  [ -n "$open" ] || { echo "Pick at least one open status."; return 1; }
  done_status=$(choose "Which status means done (set when you tick a task)?" "$(first_match 'done|complete|finish' $(( ${#statuses[@]} - 1 )) "${statuses[@]}")" "${statuses[@]}") || return 1
  local openarr
  mapfile -t openarr <<<"$open"
  new=$(choose "Status for new tasks:" "$(first_match 'next|to ?do|not started|backlog' 0 "${openarr[@]}")" "${openarr[@]}") || return 1

  # Up Next ranks priorities most urgent first. Many bases list them the
  # other way (Low, Medium, High), so flip those, then confirm.
  local prios='[]'
  if [ "$f_prio" != null ]; then
    local plist ok
    mapfile -t plist < <(choices_of "$TABLE_JSON" "$(jq -r .id <<<"$f_prio")")
    if [ ${#plist[@]} -gt 0 ]; then
      if [[ ${plist[0],,} =~ low|minor|trivial|later|someday ]] || [[ ${plist[-1],,} =~ urgent|critical|asap|highest|top ]]; then
        mapfile -t plist < <(printf '%s\n' "${plist[@]}" | tac)
      fi
      local shown
      shown=$(printf '%s, ' "${plist[@]}")
      read -r -p "Priorities, most urgent first: ${shown%, }. Right? [Y/n] " ok || return 1
      [[ ${ok:-y} =~ ^[Nn] ]] && mapfile -t plist < <(printf '%s\n' "${plist[@]}" | tac)
      prios=$(printf '%s\n' "${plist[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')
    fi
  fi

  # ---- projects
  local projects=null label=null
  if [ "$f_proj" != null ]; then
    local linked ptable pprimary
    linked=$(jq -r --arg f "$(jq -r .id <<<"$f_proj")" '.fields[] | select(.id == $f) | .options.linkedTableId' <<<"$TABLE_JSON")
    ptable=$(jq -c --arg t "$linked" '.tables[] | select(.id == $t)' <<<"$schema")
    pprimary=$(jq -r '.primaryFieldId' <<<"$ptable")
    # A lookup of the project's name on the tasks table saves an API call per refresh.
    label=$(jq -c --arg l "$(jq -r .id <<<"$f_proj")" --arg p "$pprimary" '
      [.fields[] | select(.type == "multipleLookupValues" and .options.recordLinkFieldId == $l
                          and .options.fieldIdInLinkedTable == $p) | {id, name}] | first // null' <<<"$TABLE_JSON")
    echo
    say "4. Projects"
    printf 'From the %s table.\n' "$(jq -r .name <<<"$ptable")"
    local p_name p_client p_status p_start
    p_name=$(jq -c --arg p "$pprimary" '.fields[] | select(.id == $p) | {id, name}' <<<"$ptable")
    p_client=$(pick_field "Client shown next to each project (optional)" 'client|customer|company|account' 1 '.type != "button" and .type != "attachment"' "$ptable") || return 1
    p_status=$(pick_field "Project status (optional; hides finished projects)" 'status|state|stage' 1 '.type == "singleSelect"' "$ptable") || return 1
    p_start=$(pick_field "Project start date (optional; new projects start today)" 'start|begin' 1 '.type == "date" or .type == "dateTime"' "$ptable") || return 1
    local pdone='[]' pnew=""
    if [ "$p_status" != null ]; then
      local pst pdefs=""
      mapfile -t pst < <(choices_of "$ptable" "$(jq -r .id <<<"$p_status")")
      for s in "${pst[@]}"; do [[ ${s,,} =~ $closed_re ]] && pdefs+="$s"$'\n'; done
      pdone=$(choose_many "Which project statuses mean finished (hidden from the picker)?" "$pdefs" "${pst[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))') || return 1
      pnew=$(choose "Status for projects created from the panel:" "$(first_match 'progress|active|open|current' 0 "${pst[@]}")" "${pst[@]}") || return 1
    fi
    projects=$(T=$linked N=$p_name C=$p_client S=$p_status ST=$p_start D=$pdone NEW=$pnew jq -cn '
      {tableId:env.T, name:(env.N|fromjson), client:(env.C|fromjson), status:(env.S|fromjson),
       start:(env.ST|fromjson), doneStatuses:(env.D|fromjson), newStatus:env.NEW}')
  fi

  # ---- plan
  echo
  say "5. Your Airtable plan"
  cat <<'EOF'
Airtable's Free plan allows 1,000 API calls per workspace each month, shared
by every tool connected to it. Up Next adapts:
  Team or higher: live sync, refreshing every 5 minutes.
  Free:           light sync, every 30 to 120 minutes, paced so background
                  refreshes use at most half of the calls left this month,
                  plus a refresh when you open the panel.
You can see the plan in Airtable under the workspace's Billing settings.
If Airtable ever reports the monthly limit, Up Next pauses background refreshes
until the 1st and switches to light sync.
EOF
  local plan
  plan=$(choose "Which plan is this base's workspace on?" 2 "Team or higher" "Free" "Not sure (use light sync)") || return 1
  case $plan in Team*) plan=team ;; *) plan=free ;; esac

  # ---- write
  local dir
  dir=$(dirname "$CONFIG")
  mkdir -p "$dir" && chmod 700 "$dir"
  local tmp
  tmp=$(umask 077; mktemp "$CONFIG.XXXXXX")
  # Field and status names go through the environment (see the header).
  FN=$f_name FD=$f_due FS=$f_status FP=$f_prio FST=$f_start FL=$f_proj LAB=$label \
  OPEN=$open DONE=$done_status NEW=$new PRIOS=$prios PROJECTS=$projects \
  jq -n --arg b "$BASE" --arg t "$TABLE" --arg plan "$plan" '{
      version: 1, baseId: $b, tableId: $t,
      fields: {name:(env.FN|fromjson), due:(env.FD|fromjson), status:(env.FS|fromjson),
               priority:(env.FP|fromjson), start:(env.FST|fromjson), project:(env.FL|fromjson),
               projectLabel:(env.LAB|fromjson)},
      statuses: {open: (env.OPEN | split("\n") | map(select(. != ""))), done:env.DONE, new:env.NEW},
      priorities: (env.PRIOS|fromjson), projects: (env.PROJECTS|fromjson), plan: $plan, planSource: "setup"
    }' > "$tmp" && mv "$tmp" "$CONFIG"
  chmod 600 "$CONFIG"
  rm -f "$STATE"/projects-*.json

  echo
  local result
  result=$("$0" fetch)
  if jq -e .ok <<<"$result" >/dev/null; then
    say "Done. $(jq -r '.tasks | length' <<<"$result") open tasks with a due date. Open the Up Next widget in your bar."
  else
    echo "Saved, but the test fetch failed: $(jq -r .message <<<"$result")"
    return 1
  fi
}

forget() {
  secret-tool clear "${KEYRING[@]}" 2>/dev/null
  rm -f "$CONFIG"
  rm -rf "$STATE"
  echo "Removed Up Next's token, config and cache."
}

case $1 in
  fetch) fetch ;;
  set) set_status ;;
  delete) delete_task "$2" ;;
  projects) projects ;;
  add) add_task ;;
  newproject) new_project ;;
  config) show_config ;;
  plan) set_plan "$2" ;;
  usage) usage ;;
  url) record_url "$2" ;;
  setup) setup || { echo; echo "Setup didn't finish. Run it again any time: $0 setup"; read -r -p "Press Enter to close. " _; exit 1; } ;;
  forget) forget ;;
  *) echo "usage: upnext setup | fetch | set (stdin) | delete <recId> | projects | add (stdin) | newproject (stdin) | config | plan free|team | usage | url [recId] | forget" >&2; exit 2 ;;
esac
